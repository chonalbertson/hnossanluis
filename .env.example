APP_NAME="Import Hns San Luis"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://importhnssanluis.com
APP_TIMEZONE=America/Lima

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sanluis
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ventas@hnssanluis.com"
MAIL_FROM_NAME="Import Hns San Luis"
MAIL_SALES_NOTIFICATION_TO="ventas@hnssanluis.com"

# Configuración Comercial y WhatsApp Business (Provisional / Configurable en Panel)
COMMERCIAL_PRICE_DISPLAY_MODE=mixed
COMMERCIAL_DEFAULT_CURRENCY=PEN
COMMERCIAL_QUOTE_VALIDITY_DAYS=15
WHATSAPP_BUSINESS_NUMBER=""
WHATSAPP_API_ENABLED=false
WHATSAPP_API_TOKEN=

# SEO y Analítica (No inventar IDs en producción)
GA4_MEASUREMENT_ID=""
GA4_ENABLED=false
GOOGLE_SITE_VERIFICATION=""

VITE_APP_NAME="${APP_NAME}"
